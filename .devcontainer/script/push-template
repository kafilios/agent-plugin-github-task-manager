#!/usr/bin/env bash
# push-template: sync this repo's .devcontainer into the devcontainer/git template repos.
# Same payload goes to both .devcontainer paths.
# Override targets with:
#   DEVCONTAINER_TEMPLATE_REPO=<git-url>      # single target (replaces defaults)
#   DEVCONTAINER_TEMPLATE_REPOS="url1 url2"  # whitespace-separated list (replaces defaults)
# Defaults: kafilios/devcontainer-template and kafilios/git-template.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"

if [ -n "${DEVCONTAINER_TEMPLATE_REPOS:-}" ]; then
    # shellcheck disable=SC2206  # intentional word splitting on whitespace
    TARGET_REPOS=( ${DEVCONTAINER_TEMPLATE_REPOS} )
elif [ -n "${DEVCONTAINER_TEMPLATE_REPO:-}" ]; then
    TARGET_REPOS=( "$DEVCONTAINER_TEMPLATE_REPO" )
else
    TARGET_REPOS=(
        "https://github.com/kafilios/devcontainer-template"
        "https://github.com/kafilios/git-template"
    )
fi

log() { echo "[$1] ${*:2}" >&2; }

if ! command -v git &>/dev/null; then
    log ERROR "git is required but not installed or not in PATH."
    exit 1
fi

if [ ! -d "$REPO_DIR/.devcontainer" ]; then
    log ERROR "Source .devcontainer not found at $REPO_DIR/.devcontainer."
    exit 1
fi

for REPO_URL in "${TARGET_REPOS[@]}"; do
    WORK_DIR="$(mktemp -d -t push-template.XXXXXXXXXX)"
    # Per-iteration subshell so the EXIT trap scopes the cleanup to this repo.
    (
        trap 'rm -rf "$WORK_DIR"' EXIT

        log INFO "Cloning $REPO_URL (depth 1) into $WORK_DIR ..."
        git clone --depth 1 "$REPO_URL" "$WORK_DIR/repo"

        log INFO "Replacing .devcontainer ..."
        rm -rf "$WORK_DIR/repo/.devcontainer"
        cp -r "$REPO_DIR/.devcontainer" "$WORK_DIR/repo/.devcontainer"

        cd "$WORK_DIR/repo"

        log INFO "Staging .devcontainer ..."
        git add .devcontainer

        if git diff --cached --quiet; then
            log INFO "No changes to commit for $REPO_URL; skipping push."
            exit 0
        fi

        log INFO "Committing ..."
        git commit -m "chore(devcontainer): sync .devcontainer from dotfiles-devcontainer"

        log INFO "Pushing to $REPO_URL ..."
        git push

        log INFO "Done with $REPO_URL."
    )
done

log INFO "All targets processed."
